{
  "manifest_version": 3,
  "name": "YouTube Attention Cleaner",
  "version": "1.0.1",
  "description": "Grey out YouTube videos you've already scrolled past. Skip the repeats and focus on what's actually new.",
  "author": "codingismynewgaming",
  "homepage_url": "https://github.com/codingismynewgaming/youtube-attention-cleaner",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content.js", "lib/*.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "YouTube Attention Cleaner"
  }
}
